Bootstrap: docker
From: almalinux:9.4
# Build from the repository root. Archive the tested SIF and its SHA256; OS and
# transitive package repositories are not locked by this source recipe.

%environment
    export LANG=C
    export LC_ALL=C
    export PERL5LIB=$PERL5LIB:/opt/software/homer/bin/
    export WORKFLOW_DIR=/opt/software/csRNAseq_pipeline
    export PATH=/opt/software/homer/bin/:$PATH
    export PATH=/opt/software/bfqutils/:$PATH
    export PATH=/opt/software/bam2td/:$PATH
    export PATH=/opt/software/snakemake/bin:$PATH
    export PATH=/opt/software/samtools/bin:$PATH
    export PATH=/opt/software/bedtools2/bin:$PATH
    export PATH=/opt/software/bwa/:$PATH

%files
    workflow /opt/software/csRNAseq_pipeline/workflow
    config /opt/software/csRNAseq_pipeline/config
    tests /opt/software/csRNAseq_pipeline/tests
    VERSION /opt/software/csRNAseq_pipeline/VERSION
    LICENSE /opt/software/csRNAseq_pipeline/LICENSE

%post
    dnf -y install wget langpacks-en_GB.noarch tar gzip perl-App-cpanminus dnf-plugins-core
    dnf -y install epel-release
    dnf config-manager --set-enabled crb
    dnf -y install openblas-devel
    dnf -y groupinstall "Development Tools"
    dnf -y install autoconf automake make gcc perl-Data-Dumper
    dnf -y install zlib-devel bzip2 bzip2-devel xz-devel curl-devel
    dnf -y install openssl-devel ncurses-devel libdeflate-devel
    dnf -y install libxml2-devel
    dnf -y install git
    dnf -y install pigz gawk
    dnf -y install python3.11

    mkdir -p /opt/software

    python3.11 -m venv /opt/software/snakemake
    /opt/software/snakemake/bin/pip install "snakemake==9.13.3" "pandas==2.3.3"
    # Only tests/ needs these two: pyyaml for tests/scripts/make_test_config.py and
    # pytest for the schema layer. Drop them if the container is for runs alone.
    /opt/software/snakemake/bin/pip install "pyyaml==6.0.3" "pytest==8.4.2"

    cd /opt/software
    wget https://github.com/samtools/samtools/releases/download/1.21/samtools-1.21.tar.bz2
    tar xvjf samtools-1.21.tar.bz2
    cd samtools-1.21
    ./configure --prefix=/opt/software/samtools
    make
    make install

    mkdir -p /opt/software/homer
    cd /opt/software/homer
    wget http://homer.ucsd.edu/homer/configureHomer.pl
    perl configureHomer.pl -install homer -version v5.1
    # Optional, and only a convenience: program/homer/genome also accepts a path to a
    # genome FASTA, with the annotation supplied through program/homer/tss/gtf. Swap or
    # drop this line for another organism.
    # -version disables dependency installation, so install the organism explicitly.
    perl configureHomer.pl -install arabidopsis -version v7.0
    perl configureHomer.pl -install tair10 -version v6.0

    cd /opt/software
    git clone https://github.com/noborilab/bfqutils
    cd bfqutils
    git checkout --detach c848439428ad9c2b7de0f0bc0113cc56b729577a
    make libz
    make release
    make test

    cd /opt/software
    git clone https://github.com/noborilab/bam2td
    cd bam2td
    git checkout --detach 361c8b4c5afd3e9a52067a246e055febe02074d9
    make release-full
    # Fail the build here rather than at the first make_tagdir job
    test -x /opt/software/bam2td/bam2td || { echo "bam2td did not build to the expected path" >&2; exit 1; }

    cd /opt/software
    git clone https://github.com/arq5x/bedtools2
    cd bedtools2
    git checkout --detach v2.31.1
    make

    cd /opt/software
    git clone https://github.com/lh3/bwa
    cd bwa
    git checkout --detach b92993c1161e73167181558856567ef2f367e3f0
    make

    cd /opt/software
    curl -O https://cdn.rstudio.com/r/rhel-9/pkgs/R-4.4.2-1-1.x86_64.rpm
    dnf -y install R-4.4.2-1-1.x86_64.rpm
    rm -rf R-4.4.2-1-1.x86_64.rpm
    ln -s /opt/R/4.4.2/bin/R /usr/local/bin/R
    ln -s /opt/R/4.4.2/bin/Rscript /usr/local/bin/Rscript

    R -e "install.packages('readr', repos='http://cran.us.r-project.org')"
    R -e "install.packages('data.table', repos='http://cran.us.r-project.org')"
    R -e "install.packages('BiocManager', repos='http://cran.us.r-project.org')"
    R -e "BiocManager::install('rtracklayer', version='3.20', ask=FALSE)"
    R -e "BiocManager::install('edgeR', version='3.20', ask=FALSE)"

    cd /opt/software
    # The workflow was copied from the reviewed local checkout in %files.
    chmod -R a+rX /opt/software/csRNAseq_pipeline

%runscript
    exec snakemake -s /opt/software/csRNAseq_pipeline/workflow/Snakefile "$@"

