import os
import sys
from os.path import abspath
from pathlib import Path
import pandas as pd
from snakemake.utils import validate
from snakemake.utils import min_version

min_version("9.13.3")

shell.prefix("set -euo pipefail; ")

configfile: "config/config.yaml"


validate(config, "schemas/config.schema.yaml")

sampletab = pd.read_csv(config["sample_table"], sep="\t")
# Fill optional columns before validation so that a column present in the
# header but with all-empty values (read as NaN by pandas) does not fail
# the JSON schema type check for "string".
if "replicate" not in sampletab.columns:
    sampletab["replicate"] = 1
if "read_r2" not in sampletab.columns:
    sampletab["read_r2"] = ""
if "input_name" not in sampletab.columns:
    sampletab["input_name"] = ""
sampletab["replicate"] = sampletab["replicate"].fillna(1).astype(int)
sampletab["read_r2"] = sampletab["read_r2"].fillna("").astype(str)
sampletab["input_name"] = sampletab["input_name"].fillna("").astype(str)
validate(sampletab, "schemas/samples.schema.yaml")
sampletab["sample_name"] = sampletab["sample_name"].str.strip()
sampletab["input_name"] = sampletab["input_name"].str.strip()
sampletab["id"] = list(
    sampletab["sample_name"]
    + "_"
    + sampletab["sample_type"]
    + sampletab["replicate"].astype(str)
)
# Strip all non-word chars (including whitespace) so IDs are safe as filenames
sampletab["id"] = sampletab["id"].str.replace(r"[^\w]", "", regex=True)
if sampletab["id"].duplicated().any():
    dups = sampletab.loc[sampletab["id"].duplicated(keep=False), "id"].tolist()
    sys.exit(
        f"ERROR: duplicate sample IDs (from sample_name+sample_type+replicate): {dups}\n"
        "Check for duplicate (sample_name, sample_type, replicate) rows in your sample table."
    )
sampletab = sampletab.set_index("id", drop=False)
sampletab["read_r1"] = sampletab["read_r1"].str.strip()
sampletab["read_r2"] = sampletab["read_r2"].str.strip()

try:
    chromsizes = pd.read_csv(
        config["chrom_sizes"], sep="\t", header=None, usecols=[0, 1]
    )
except:
    sys.exit(
        "chrom.sizes must be a TSV with at least 2 columns, the second of which is an integer column"
    )
if not chromsizes[1].dtype.kind == "i":
    sys.exit("The second column of the chrom.sizes file must be integers")
chromsizes[0] = chromsizes[0].astype(str)
VALID_CHROMS = chromsizes[0].tolist()

MIN_ALN_THREADS = max(2, config["program"]["alignment_threads"])
MIN_TRIM_THREADS = 2
PIGZ_THREADS = 0
if config["program"]["bfqutils"]["use_pigz"]:
    PIGZ_THREADS = config["program"]["bfqutils"]["pigz_threads"]
    if PIGZ_THREADS < 0:
        PIGZ_THREADS = 0
    if PIGZ_THREADS + MIN_TRIM_THREADS > workflow.cores:
        PIGZ_THREADS = workflow.cores - MIN_TRIM_THREADS
    MIN_TRIM_THREADS += PIGZ_THREADS
    # When using gzip or pigz -p 1, bfqutils is bottlenecked by the read
    # zipping and will not use more than 100% of a thread between both
    # trimming and stats calculations. Therefore pigz/gzip
    # can be given an additional thread beyond MIN_TRIM_THREADS.
    if PIGZ_THREADS == 0:
        PIGZ_THREADS = 1

try:
    PIPELINE_VERSION = (Path(workflow.basedir).parent / "VERSION").read_text().strip()
except OSError:
    PIPELINE_VERSION = "unknown"

INTERMEDIATE_DIR = abspath(config["files"]["intermediate_dir"])
OUTPUT_DIR = abspath(config["files"]["output_dir"])

# Optional annotation for TSS calling. Without a GTF (or a HOMER genome that carries its
# own annotation) findcsRNATSS cannot build the annotated-TSS / exon true-positive and
# false-positive sets it uses to pick the enrichment threshold, and silently falls back to
# -defaultLog2Fold; it also cannot fill in the promoter-distal and stable-transcript
# columns, which are then written as placeholders. Optional because the pipeline must keep
# working for organisms with no annotation to hand.
TSS_GTF = (config["program"]["homer"]["tss"].get("gtf") or "").strip()
TSS_RNA_TAGDIR = (config["program"]["homer"]["tss"].get("rnaseq_tagdir") or "").strip()
if TSS_GTF:
    if not os.path.isfile(TSS_GTF):
        sys.exit(f"ERROR: program/homer/tss/gtf does not exist: {TSS_GTF!r}")
    with open(TSS_GTF) as _fh:
        _line = next((l for l in _fh if l.strip() and not l.startswith("#")), "")
    if len(_line.split("\t")) < 9:
        sys.exit(
            f"ERROR: program/homer/tss/gtf does not look like a GTF: {TSS_GTF!r}\n"
            "       Expected 9 tab-separated fields on the first non-comment line."
        )

# The RNA-seq side takes a tag directory, not FASTQ, and deliberately so: RNA-seq reads are
# spliced and longer than csRNA reads, whereas this pipeline's trim step caps reads at
# filtering/max_read_length (70 by default) and its aligners are set up for short unspliced
# reads (bwa-aln, or STAR with align_intron_max 1). Feeding mRNA-seq through that path would
# quietly build a wrong tag directory: reads truncated, junction-spanning reads lost. So the
# RNA-seq tag directory is built separately, with a splice-aware aligner, and pointed at
# here. Both checks below exist because a bad path otherwise fails deep inside HOMER.
if TSS_RNA_TAGDIR:
    if not os.path.isdir(TSS_RNA_TAGDIR):
        sys.exit(
            f"ERROR: program/homer/tss/rnaseq_tagdir is not a directory: {TSS_RNA_TAGDIR!r}\n"
            "       It must be a HOMER tag directory built from your RNA-seq reads, not a\n"
            "       FASTQ. This pipeline cannot build it for you: its trim and alignment\n"
            "       settings are for short unspliced reads, so RNA-seq run through them\n"
            "       would lose spliced reads and be truncated to max_read_length."
        )
    if not os.path.isfile(os.path.join(TSS_RNA_TAGDIR, "tagInfo.txt")):
        sys.exit(
            f"ERROR: program/homer/tss/rnaseq_tagdir has no tagInfo.txt: {TSS_RNA_TAGDIR!r}\n"
            "       That file is what makes a directory a HOMER tag directory. Build one\n"
            "       with makeTagDirectory or bam2td from a splice-aware RNA-seq alignment."
        )

# findcsRNATSS.pl announces itself as a legacy placeholder for findcsRNATSR.pl. The two
# are the same program (81 diff lines, all renames and help text) and produce identical
# tables, so switching is safe, but TSR ships with an unpatched "use lib" pointing at the
# author's own install, so it only resolves HomerConfig when HOMER's bin directory is on
# PERL5LIB. The default therefore stays on the legacy name.
TSS_PROGRAM = config["program"]["homer"]["tss"].get("program", "findcsRNATSS.pl")


def index_sentinel(aln, index):
    """Return the file whose existence indicates the genome index is fully built."""
    if aln in ("bwa-aln", "bwa-mem"):
        return index + ".bwt"
    elif aln == "STAR":
        return os.path.join(index, "SA")
    elif aln == "bowtie2":
        return index + ".1.bt2"
    elif aln == "hisat2":
        return index + ".1.ht2"
    else:
        sys.exit(f"ERROR: Unknown alignment program [{aln}]")


INDEX_SENTINEL = index_sentinel(
    config["program"]["alignment_program"],
    config["program"]["genome_index"],
)

# For STAR the index is a directory; if genome_index points to an existing
# regular file the sentinel path (index/SA) is invalid and causes a crash.
if (
    config["program"]["alignment_program"] == "STAR"
    and os.path.isfile(config["program"]["genome_index"])
):
    sys.exit(
        f"ERROR: alignment_program is STAR but genome_index points to a file: "
        f"{config['program']['genome_index']!r}. "
        "For STAR, genome_index must be a directory path "
        "(e.g. /path/to/star_index/). "
        "Update genome_index to the directory where the STAR index is or will be built."
    )

NEED_INDEX = not os.path.exists(INDEX_SENTINEL)
if NEED_INDEX and not config.get("genome_fasta"):
    sys.exit(
        "ERROR: genome_index not found and genome_fasta is not set. "
        "Either provide a pre-built index at genome_index, or set genome_fasta "
        "so the pipeline can build one automatically."
    )


def get_matching_sample(s):
    """Return the id of the input tag dir paired to csRNA sample s.
    On csRNA rows, input_name (if set) overrides sample_name for the lookup."""
    s_rep = sampletab.loc[s, "replicate"]
    s_name = sampletab.loc[s, "sample_name"]
    s_type = sampletab.loc[s, "sample_type"]
    if s_type == "csrna":
        lookup_name = sampletab.loc[s, "input_name"] or s_name
        s_match = sampletab.loc[sampletab["sample_type"] == "input"]
        if s_match.shape[0] == 0:
            sys.exit(f"ERROR: All samples must have a matching csrna and input [{s}]")
        s_match = s_match[s_match["replicate"] == s_rep]
        if s_match.shape[0] == 0:
            sys.exit(f"ERROR: All samples must have a matching csrna and input [{s}]")
        s_match = s_match[s_match["sample_name"] == lookup_name]
        if s_match.shape[0] == 0:
            sys.exit(f"ERROR: All samples must have a matching csrna and input [{s}]")
        if s_match.shape[0] > 1:
            sys.exit(
                f"ERROR: Each csrna sample must only have a single matching input [{s}]"
            )
        return s_match["id"].iloc[0]
    else:
        s_match = sampletab.loc[sampletab["sample_type"] == "csrna"]
        s_match = s_match[s_match["replicate"] == s_rep]
        s_match = s_match[s_match["sample_name"] == s_name]
        if s_match.shape[0] == 0:
            sys.exit(f"ERROR: All samples must have a matching csrna and input [{s}]")
        if s_match.shape[0] > 1:
            sys.exit(
                f"ERROR: Each input sample must only have a single matching csrna [{s}]"
            )
        return s_match["id"].iloc[0]


def _validate_input_has_dependents(inp):
    """Check that at least one csRNA sample depends on input sample inp."""
    inp_rep = sampletab.loc[inp, "replicate"]
    inp_name = sampletab.loc[inp, "sample_name"]
    cs_rows = sampletab.loc[sampletab["sample_type"] == "csrna"]
    effective_names = cs_rows["input_name"].where(
        cs_rows["input_name"] != "", cs_rows["sample_name"]
    )
    dependents = cs_rows[
        (effective_names == inp_name) & (cs_rows["replicate"] == inp_rep)
    ]
    if dependents.shape[0] == 0:
        sys.exit(
            f"ERROR: input sample [{inp}] has no csrna samples depending on it. "
            "Remove it from the sample table or add a matching csrna row."
        )


# Check that all samples have a single matching cssrna/input before starting
for cs in sampletab.loc[sampletab["sample_type"] == "csrna", "id"]:
    get_matching_sample(cs)
for inp in sampletab.loc[sampletab["sample_type"] == "input", "id"]:
    _validate_input_has_dependents(inp)

# Validate tss_min_reps: a value above the maximum replicate count would yield
# an empty consensus set; a value above the minimum silently drops conditions.
_min_reps = config["filtering"]["tss_min_reps"]
_reps_per_cond = (
    sampletab[sampletab["sample_type"] == "csrna"].groupby("sample_name").size()
)
if _min_reps > _reps_per_cond.max():
    sys.exit(
        f"ERROR: tss_min_reps={_min_reps} exceeds the maximum csRNA replicate "
        f"count ({_reps_per_cond.max()}); the consensus TSS set would be empty."
    )
if _min_reps > _reps_per_cond.min():
    _short = _reps_per_cond[_reps_per_cond < _min_reps].index.tolist()
    sys.stderr.write(
        f"WARNING: tss_min_reps={_min_reps} but the following sample_name "
        f"groups have fewer csRNA replicates: {_short}. They will not "
        "contribute to the consensus TSS set.\n"
    )

# Make sure no spaces in fastq filenames
for i in range(sampletab.shape[0]):
    if " " in sampletab["read_r1"].iloc[i]:
        sys.exit(
            f"ERROR: FastQ filenames cannot contain spaces [{sampletab['read_r1'].iloc[i]}]"
        )
    if " " in sampletab["read_r2"].iloc[i]:
        sys.exit(
            f"ERROR: FastQ filenames cannot contain spaces [{sampletab['read_r2'].iloc[i]}]"
        )


conda: "workflow/envs/env.yaml"


