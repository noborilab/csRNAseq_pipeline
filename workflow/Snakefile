rule generate_normalized_bw:
    message:
        "Generating normalized bigWigs for {wildcards.sample_cs}"
    input:
        normfactors=OUTPUT_DIR + "/norm_factors.txt",
        bed=OUTPUT_DIR + "/tss.final.bed",
        srna=INTERMEDIATE_DIR + "/tss_merged/all_in.tss_merged.bed",
        bg_p=OUTPUT_DIR + "/bedgraph/{sample_cs}.raw.pos.bedGraph.gz",
        bg_n=OUTPUT_DIR + "/bedgraph/{sample_cs}.raw.neg.bedGraph.gz",
    output:
        bw_p=OUTPUT_DIR + "/bw/{sample_cs}.rpm.pos.bw",
        bw_n=OUTPUT_DIR + "/bw/{sample_cs}.rpm.neg.bw",
    benchmark:
        OUTPUT_DIR + "/qc/{sample_cs}.generate_bw.benchmark.txt",
    resources:
        mem_mb=2000,
    params:
        cs=config["chrom_sizes"],
        mask_srnas=config["filtering"]["mask_srnas_from_bw"],
    script:
        "scripts/generate_normalized_bw.R"
