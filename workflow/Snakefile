rule run_info:
    message:
        "Recording run provenance"
    input:
        # Depends on the last outputs so the manifest reflects a finished run.
        OUTPUT_DIR + "/tss.final.cpm.txt",
        OUTPUT_DIR + "/qc_final_cs.txt",
    output:
        OUTPUT_DIR + "/run_info.txt",
    resources:
        mem_mb=500,
    params:
        repo=workflow.basedir + "/..",
        version=PIPELINE_VERSION,
        sample_table=config["sample_table"],
        snakemake_version=snakemake.__version__,
    run:
        import json
        import tempfile

        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as fh:
            json.dump(dict(config), fh, indent=2, default=str)
            dump = fh.name
        shell(
            "PIPELINE_VERSION={params.version:q} REPO_DIR={params.repo:q} "
            "SAMPLE_TABLE={params.sample_table:q} SNAKEMAKE_VERSION={params.snakemake_version:q} "
            "CONFIG_DUMP=" + dump + " OUT={output:q} "
            "bash " + workflow.basedir + "/scripts/write_run_info.sh"
        )
        os.unlink(dump)


