        in_names=" ".join(list(sampletab["id"][sampletab["sample_type"] == "input"])),
        prefix=OUTPUT_DIR + "/tagdir",
        bg_prefix=OUTPUT_DIR + "/bedgraph",
        log_prefix=OUTPUT_DIR + "/qc",
        organelle_chroms=" ".join(config.get("qc", {}).get("organelle_chroms", ["Pt", "Mt"])),
    shell:
