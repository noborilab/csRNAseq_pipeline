            sample_cs=sampletab["id"][sampletab["sample_type"] == "csrna"],
        ),


def get_input_r1(r):
    r = r.split(",")
    return [abspath(r_.strip()) for r_ in r]


def get_input_r2(r):
    return get_input_r1(r) if r else []


rule trim:
    message:
        "Trimming {wildcards.sample}"
    input:
        r1=lambda wildcards: get_input_r1(
            sampletab.loc[wildcards.sample, "read_r1"],
        ),
        r2=lambda wildcards: get_input_r2(
            sampletab.loc[wildcards.sample, "read_r2"],
        ),
    output:
        temp(INTERMEDIATE_DIR + "/trim/{sample}.fq.gz")
        if not config["program"]["keep_trimmed_fastq"]
        else INTERMEDIATE_DIR + "/trim/{sample}.fq.gz",
    benchmark:
        OUTPUT_DIR + "/qc/{sample}.trim.benchmark.txt",
    resources:
        mem_mb=1000,
    params:
        max_len=config["filtering"]["max_read_length"],
        adp=config["program"]["bfqutils"]["sequencing_adapter"],
        zip_cmd=(
            f"pigz -p {PIGZ_THREADS}"
            if config["program"]["bfqutils"]["use_pigz"]
            else "gzip"
        ),
        trim_cmd=lambda wildcards: (
            "merge" if sampletab.loc[wildcards.sample, "read_r2"] else "trimse"
        ),
    log:
        trimming=OUTPUT_DIR + "/qc/{sample}.trimming.txt",
        lengths=OUTPUT_DIR + "/qc/{sample}.trim.lengths.txt",
        gc=OUTPUT_DIR + "/qc/{sample}.trim.gc.txt",
        qual=OUTPUT_DIR + "/qc/{sample}.trim.qual.txt",
        ppqual=OUTPUT_DIR + "/qc/{sample}.trim.ppqual.txt",
        ppbase=OUTPUT_DIR + "/qc/{sample}.trim.ppbase.txt",
        kmer=OUTPUT_DIR + "/qc/{sample}.trim.kmer.txt",
        summary=OUTPUT_DIR + "/qc/{sample}.trim.summary.txt",
    threads: MIN_TRIM_THREADS
    shell:
        """
            INPUTR1=`echo {input.r1:q} | sed 's/ /,/g'`
            INPUTR2=`echo {input.r2:q} | sed 's/ /,/g'`
            bfqutils {params.trim_cmd} -m {params.max_len} $INPUTR1 $INPUTR2 \
                2> {log.trimming} \
            | bfqutils stats -O -N -l {log.lengths} -g {log.gc} \
                -q {log.qual} -Q {log.ppqual} -b {log.ppbase} -k {log.kmer} \
                -o {log.summary} - \
            | {params.zip_cmd} > {output}
        """


def build_index_cmd(fasta, index, threads):
    aln = config["program"]["alignment_program"]
    if aln in ("bwa-aln", "bwa-mem"):
        # bwa index is single-threaded; the threads parameter is unused here
        return f"bwa index -p {index} {fasta}"
    elif aln == "STAR":
        nbases = config["program"]["star"]["genome_sa_index_nbases"]
        return (
            f"mkdir -p {index}; "
            f"STAR --runMode genomeGenerate --genomeDir {index} "
            f"--genomeFastaFiles {fasta} --runThreadN {threads} "
            f"--genomeSAindexNbases {nbases}"
        )
    elif aln == "bowtie2":
        return f"bowtie2-build --threads {threads} {fasta} {index}"
    elif aln == "hisat2":
        return f"hisat2-build -p {threads} {fasta} {index}"
    else:
        sys.exit("ERROR: Unknown alignment program")


def build_aln_cmd(i, o, l_flagstat, l_aln, t):
    aln = config["program"]["alignment_program"]
    excl_f = config["filtering"]["exclude_flags"]
    incl_f = config["filtering"]["include_flags"]
    minlen = config["filtering"]["min_alignment_length"]
    mapq = config["filtering"]["alignment_mapq"]
    index = config["program"]["genome_index"]
    maxm = config["filtering"]["max_mismatch"]
    # STAR uses the lowercase nM tag (mismatches only); other aligners use NM (mismatches+indels).
    nm_tag = "nM" if aln == "STAR" else "NM"
    filter_expr = f"rlen>={minlen} && [{nm_tag}]<={maxm}"
    cmd_filt = f"samtools view -b -q {mapq} -e '{filter_expr}' "
    if excl_f > 0:
        cmd_filt += f"-F {excl_f} "
    if incl_f > 0:
        cmd_filt += f"-f {incl_f} "
    cmd_post = f"samtools index {o}; samtools flagstat {o} > {l_flagstat}"
    cmd_aln = ""
    if aln == "bwa-aln":
        sai = o + ".sai"
        cmd_aln = f"bwa aln -o 0 -t {t} {index} {i} > {sai} 2> {l_aln}; "
        cmd_aln += f"bwa samse {index} {sai} {i} 2>> {l_aln} | "
        cmd_filt += f"- | samtools sort -T {o}.tmp --verbosity 0 -@ $(({t}-2)) -o {o}; "
        if not config["program"]["bwa_aln"]["keep_sai"]:
            cmd_post += f"; rm {sai}"
    elif aln == "bwa-mem":
        bwa_w = config["program"]["bwa_mem"]["w"]
        bwa_L = config["program"]["bwa_mem"]["L"]
        bwa_O = config["program"]["bwa_mem"]["O"]
        cmd_aln = (
            f"bwa mem -t $(({t}-1)) -w {bwa_w} -L {bwa_L} -O {bwa_O} {index} {i} 2> {l_aln} | "
        )
        cmd_filt += (
            f"- | samtools sort -T {o}.tmp --verbosity 0 -o {o}; "
        )
    elif aln == "STAR":
        readcmd = config["program"]["star"]["read_files_command"]
        aet = config["program"]["star"]["align_ends_type"]
        aim = config["program"]["star"]["align_intron_max"]
        ofmn = config["program"]["star"]["out_filter_multimap_nmax"]
        cmd_aln = f"STAR --genomeDir {index} --readFilesIn {i} "
        cmd_aln += f"--outFilterMultimapNmax {ofmn} "
        cmd_aln += f"--outFilterMatchNmin {minlen} "
        cmd_aln += f"--alignEndsType {aet} --alignIntronMax {aim} "
        cmd_aln += f"--runThreadN {t} --readFilesCommand {readcmd} "
        cmd_aln += f"--outSAMtype BAM Unsorted "
        base = str(Path(os.path.basename(o)).with_suffix("").with_suffix(""))
        prefix = os.path.dirname(o) + "/" + base + "."
        cmd_aln += f"--outFileNamePrefix {prefix} > {l_aln} 2>&1; "
        unsrt = prefix + "Aligned.out.bam"
        cmd_filt += f"{unsrt} | samtools sort -T {o}.tmp --verbosity 0 -@ $(({t}-2)) -o {o}; "
    elif aln == "bowtie2":
        bt2_ext = config["program"]["bowtie2"]["extra_params"]
        cmd_aln = f"bowtie2 {bt2_ext} -p $(({t}-1)) -x {index} -U {i} 2> {l_aln} | "
        cmd_filt += (
            f"- | samtools sort -T {o}.tmp --verbosity 0 -o {o}; "
        )
    elif aln == "hisat2":
        ht2_ext = config["program"]["hisat2"]["extra_params"]
        cmd_aln = f"hisat2 {ht2_ext} -p $(({t}-1)) -x {index} -U {i} 2> {l_aln} | "
        cmd_filt += (
            f"- | samtools sort -T {o}.tmp --verbosity 0 -o {o}; "
        )
    else:
        sys.exit("ERROR: Unknown alignment program")
    return cmd_aln + cmd_filt + cmd_post


if NEED_INDEX:

    rule build_index:
        message:
            "Building {} index".format(config["program"]["alignment_program"])
        input:
            config["genome_fasta"],
        output:
            INDEX_SENTINEL,
        log:
            OUTPUT_DIR + "/qc/build_index.log",
        benchmark:
            OUTPUT_DIR + "/qc/build_index.benchmark.txt",
        threads: MIN_ALN_THREADS
        resources:
            mem_mb=16000,
        shell:
            build_index_cmd("{input}", config["program"]["genome_index"], "{threads}")
            + " > {log} 2>&1"


rule align:
    message:
        "Aligning {wildcards.sample}"
    input:
        fq=INTERMEDIATE_DIR + "/trim/{sample}.fq.gz",
        idx=INDEX_SENTINEL if NEED_INDEX else [],
    output:
        bam=temp(INTERMEDIATE_DIR + "/bam/{sample}.sort.bam")
        if not config["program"]["keep_bam"]
        else INTERMEDIATE_DIR + "/bam/{sample}.sort.bam",
        bai=temp(INTERMEDIATE_DIR + "/bam/{sample}.sort.bam.bai")
        if not config["program"]["keep_bam"]
        else INTERMEDIATE_DIR + "/bam/{sample}.sort.bam.bai",
    log:
        flagstat=OUTPUT_DIR + "/qc/{sample}.aln.txt",
        aligner=OUTPUT_DIR + "/qc/{sample}.aligner.log",
    benchmark:
        OUTPUT_DIR + "/qc/{sample}.align.benchmark.txt",
    threads: MIN_ALN_THREADS
    resources:
        mem_mb=8000,
    shell:
        build_aln_cmd(
            "{input.fq}", "{output.bam}", "{log.flagstat}", "{log.aligner}", "{threads}"
        )


rule make_tagdir:
    message:
        "Building HOMER tag directory for {wildcards.sample}"
    input:
        INTERMEDIATE_DIR + "/bam/{sample}.sort.bam",
    shadow:
        "minimal"
    output:
        directory(OUTPUT_DIR + "/tagdir/{sample}"),
    log:
        OUTPUT_DIR + "/qc/{sample}.tagdir.log",
    benchmark:
        OUTPUT_DIR + "/qc/{sample}.tagdir.benchmark.txt",
    resources:
        mem_mb=4000,
    params:
        genome=config["program"]["homer"]["genome"],
        opt=config["program"]["homer"]["tagdir"]["extra_args"],
    shell:
        """
            samtools view -h {input} > {input}.sam
            makeTagDirectory {output} {input}.sam -genome {params.genome} {params.opt} > {log} 2>&1
            rm {input}.sam
        """


rule find_tss_initial:
    message:
        "Calling TSSs for {wildcards.sample}"
    input:
        sample=OUTPUT_DIR + "/tagdir/{sample}",
        match=lambda wildcards: OUTPUT_DIR
        + "/tagdir/"
        + get_matching_sample(wildcards.sample),
    shadow:
        "minimal"
    output:
        tss=OUTPUT_DIR + "/tss/{sample}.tss.txt",
        bed=OUTPUT_DIR + "/bed/{sample}.tss.bed",
    log:
        OUTPUT_DIR + "/qc/{sample}.find_tss.log",
    benchmark:
        OUTPUT_DIR + "/qc/{sample}.find_tss.benchmark.txt",
    threads: 3
    resources:
        mem_mb=8000,
    params:
        prefix=OUTPUT_DIR + "/tss/{sample}",
        genome=config["program"]["homer"]["genome"],
        size=config["program"]["homer"]["tss"]["size"],
        ntags=config["program"]["homer"]["tss"]["ntagthreshold"],
        opt=config["program"]["homer"]["tss"]["extra_args"],
    shell:
        """
            findcsRNATSS.pl {input.sample} -i {input.match} \
                -o {params.prefix} -genome {params.genome} \
                -size {params.size} -ntagThreshold {params.ntags} {params.opt} > {log} 2>&1
            pos2bed.pl -o {output.bed} {output.tss} 2>> {log}
        """


rule make_raw_bedgraph:
    message:
        "Generating raw bedGraphs for {wildcards.sample}"
    input:
        OUTPUT_DIR + "/tagdir/{sample}",
    output:
        pos=OUTPUT_DIR + "/bedgraph/{sample}.raw.pos.bedGraph.gz",
        neg=OUTPUT_DIR + "/bedgraph/{sample}.raw.neg.bedGraph.gz",
    log:
        OUTPUT_DIR + "/qc/{sample}.bedgraph.log",
    benchmark:
        OUTPUT_DIR + "/qc/{sample}.bedgraph.benchmark.txt",
    resources:
        mem_mb=2000,
    params:
        pos=OUTPUT_DIR + "/bedgraph/{sample}.raw.pos.bedGraph",
        neg=OUTPUT_DIR + "/bedgraph/{sample}.raw.neg.bedGraph",
    shell:
        """
            makeUCSCfile {input} -style tss -strand + -raw -o {params.pos} > {log} 2>&1
            makeUCSCfile {input} -style tss -strand - -raw -o {params.neg} >> {log} 2>&1
        """


rule gather_stats:
    message:
        "Gathering tag and alignment stats"
    input:
        cs=list(
            (OUTPUT_DIR + "/tagdir/") + s
            for s in sampletab["id"][sampletab["sample_type"] == "csrna"]
        ),
        inp=list(
            (OUTPUT_DIR + "/tagdir/") + s
            for s in sampletab["id"][sampletab["sample_type"] == "input"]
        ),
    output:
        cs=OUTPUT_DIR + "/qc/stats_cs.txt",
        inp=OUTPUT_DIR + "/qc/stats_in.txt",
    benchmark:
        OUTPUT_DIR + "/qc/gather_stats.benchmark.txt",
    resources:
        mem_mb=500,
    params:
        cs_names=" ".join(list(sampletab["id"][sampletab["sample_type"] == "csrna"])),
        in_names=" ".join(list(sampletab["id"][sampletab["sample_type"] == "input"])),
        prefix=OUTPUT_DIR + "/tagdir",
    shell:
        """
            OUT_PREFIX={params.prefix} OUT={output.cs} bash workflow/scripts/gather_stats.sh {params.cs_names}
            OUT_PREFIX={params.prefix} OUT={output.inp} bash workflow/scripts/gather_stats.sh {params.in_names}
        """


rule merge_initial_tss:
    message:
        "Merging per-sample TSSs"
    input:
        (OUTPUT_DIR + "/bed/" + s + ".tss.bed" for s in sampletab["id"]),
    output:
        cs=INTERMEDIATE_DIR + "/tss_merged/all_cs.tss_merged.bed",
        inp=INTERMEDIATE_DIR + "/tss_merged/all_in.tss_merged.bed",
    benchmark:
        OUTPUT_DIR + "/qc/merge_initial_tss.benchmark.txt",
    resources:
        mem_mb=2000,
    params:
        in_cs=" ".join(
            OUTPUT_DIR + "/bed/" + s + ".tss.bed"
            for s in sampletab["id"][sampletab["sample_type"] == "csrna"]
        ),
        in_in=" ".join(
            OUTPUT_DIR + "/bed/" + s + ".tss.bed"
            for s in sampletab["id"][sampletab["sample_type"] == "input"]
        ),
        valid_chroms=" ".join(VALID_CHROMS),
    shell:
        """
            cat {params.in_cs} \
            | bedtools sort -i stdin \
            | bedtools merge -s -c 6 -o distinct -i stdin \
            | bedtools sort -i stdin \
            | awk -v vc="{params.valid_chroms}" \
                'BEGIN{{IFS="\t";OFS="\t";n=split(vc,a," ");for(i=1;i<=n;i++) ok[a[i]]=1}} \
                (ok[$1]){{print $1,$2,$3,"TSS_" NR,"0",$4}}' \
                > {output.cs}
            cat {params.in_in} \
            | bedtools sort -i stdin \
            | bedtools merge -s -c 6 -o distinct -i stdin \
            | bedtools sort -i stdin \
            | awk -v vc="{params.valid_chroms}" \
                'BEGIN{{IFS="\t";OFS="\t";n=split(vc,a," ");for(i=1;i<=n;i++) ok[a[i]]=1}} \
                (ok[$1]){{print $1,$2,$3,"TSS_" NR,"0",$4}}' \
                > {output.inp}
        """


rule quantify_initial_cs_tss:
    message:
        "Quantifying csRNA-merged TSSs"
    input:
        tss=INTERMEDIATE_DIR + "/tss_merged/all_cs.tss_merged.bed",
        cs=list(
            (OUTPUT_DIR + "/tagdir/") + s
            for s in sampletab["id"][sampletab["sample_type"] == "csrna"]
        ),
        inp=list(
            (OUTPUT_DIR + "/tagdir/") + s
            for s in sampletab["id"][sampletab["sample_type"] == "input"]
        ),
    shadow:
        "minimal"
    output:
        cs=INTERMEDIATE_DIR + "/tss_merged/all_cs.tss_merged_quant_cs.txt",
        inp=INTERMEDIATE_DIR + "/tss_merged/all_cs.tss_merged_quant_in.txt",
    log:
        OUTPUT_DIR + "/qc/quantify_cs_tss.log",
    benchmark:
        OUTPUT_DIR + "/qc/quantify_cs_tss.benchmark.txt",
    resources:
        mem_mb=4000,
    params:
        genome=config["program"]["homer"]["genome"],
    shell:
        """
            annotatePeaks.pl {input.tss} {params.genome} \
                -strand + -fragLength 1 -raw -d {input.cs} \
                > {output.cs} 2> {log}
            annotatePeaks.pl {input.tss} {params.genome} \
                -strand + -fragLength 1 -raw -d {input.inp} \
                > {output.inp} 2>> {log}
        """


rule quantify_initial_in_tss:
    message:
        "Quantifying input-merged TSSs"
    input:
        tss=INTERMEDIATE_DIR + "/tss_merged/all_in.tss_merged.bed",
        cs=list(
            (OUTPUT_DIR + "/tagdir/") + s
            for s in sampletab["id"][sampletab["sample_type"] == "csrna"]
        ),
        inp=list(
            (OUTPUT_DIR + "/tagdir/") + s
            for s in sampletab["id"][sampletab["sample_type"] == "input"]
        ),
    shadow:
        "minimal"
    output:
        cs=INTERMEDIATE_DIR + "/tss_merged/all_in.tss_merged_quant_cs.txt",
        inp=INTERMEDIATE_DIR + "/tss_merged/all_in.tss_merged_quant_in.txt",
    log:
        OUTPUT_DIR + "/qc/quantify_in_tss.log",
    benchmark:
        OUTPUT_DIR + "/qc/quantify_in_tss.benchmark.txt",
    resources:
        mem_mb=4000,
    params:
        genome=config["program"]["homer"]["genome"],
    shell:
        """
            annotatePeaks.pl {input.tss} {params.genome} \
                -strand + -fragLength 1 -raw -d {input.cs} \
                > {output.cs} 2> {log}
            annotatePeaks.pl {input.tss} {params.genome} \
                -strand + -fragLength 1 -raw -d {input.inp} \
                > {output.inp} 2>> {log}
        """


rule qc_initial_tss:
    message:
        "Computing QC metrics"
    benchmark:
        OUTPUT_DIR + "/qc/qc_initial_tss.benchmark.txt",
    input:
        quant_cs_cs=INTERMEDIATE_DIR + "/tss_merged/all_cs.tss_merged_quant_cs.txt",
        quant_cs_in=INTERMEDIATE_DIR + "/tss_merged/all_cs.tss_merged_quant_in.txt",
        quant_in_cs=INTERMEDIATE_DIR + "/tss_merged/all_in.tss_merged_quant_cs.txt",
        quant_in_in=INTERMEDIATE_DIR + "/tss_merged/all_in.tss_merged_quant_in.txt",
        stats_cs=OUTPUT_DIR + "/qc/stats_cs.txt",
        stats_in=OUTPUT_DIR + "/qc/stats_in.txt",
        tss_cs=INTERMEDIATE_DIR + "/tss_merged/all_cs.tss_merged.bed",
        tss_in=INTERMEDIATE_DIR + "/tss_merged/all_in.tss_merged.bed",
    output:
        qc_cs=OUTPUT_DIR + "/qc/qc_cs.txt",
        qc_in=OUTPUT_DIR + "/qc/qc_in.txt",
    resources:
        mem_mb=2000,
    params:
        mirnas=config["qc"]["mirnas"],
        trnas=config["qc"]["trnas"],
    script:
        "scripts/qc_initial_tss.R"


rule collect_consensus_tss:
    message:
        "Building consensus TSS set"
    input:
        tss_cs=list(
            (OUTPUT_DIR + "/bed/") + s + ".tss.bed"
            for s in sampletab["id"][sampletab["sample_type"] == "csrna"]
        ),
        tss_in=INTERMEDIATE_DIR + "/tss_merged/all_in.tss_merged.bed",
    output:
        OUTPUT_DIR + "/tss.final.bed",
    benchmark:
        OUTPUT_DIR + "/qc/collect_consensus_tss.benchmark.txt",
    resources:
        mem_mb=2000,
    params:
        min_reps=config["filtering"]["tss_min_reps"],
        sample_names=" ".join(list(sampletab["sample_name"])),
        sample_types=" ".join(list(sampletab["sample_type"])),
        replicates=" ".join(list(sampletab["replicate"].astype(str))),
        bed_dir=OUTPUT_DIR + "/bed",
        bg_dir=OUTPUT_DIR + "/bedgraph",
        chrom_sizes=config["chrom_sizes"],
        mirnas=config["qc"]["mirnas"],
        trnas=config["qc"]["trnas"],
    script:
        "scripts/collect_consensus_tss.R"


