            OUT_PREFIX={params.prefix} BG_PREFIX={params.bg_prefix} LOG_PREFIX={params.log_prefix} OUT={output.cs} ORGANELLE_CHROMS="{params.organelle_chroms}" bash {workflow.basedir}/scripts/gather_stats.sh {params.cs_names}
            OUT_PREFIX={params.prefix} BG_PREFIX={params.bg_prefix} LOG_PREFIX={params.log_prefix} OUT={output.inp} ORGANELLE_CHROMS="{params.organelle_chroms}" bash {workflow.basedir}/scripts/gather_stats.sh {params.in_names}
        """


rule merge_initial_tss:
    message:
        "Merging per-sample TSSs"
    input:
        (OUTPUT_DIR + "/bed/" + s + ".tss.bed" for s in sampletab["id"]),
    output:
        cs=OUTPUT_DIR + "/tss_merged/all_cs.tss_merged.bed",
        inp=OUTPUT_DIR + "/tss_merged/all_in.tss_merged.bed",
    benchmark:
        OUTPUT_DIR + "/qc/merge_initial_tss.benchmark.txt",
    resources:
        mem_mb=2000,
    params:
        in_cs=" ".join(
            OUTPUT_DIR + "/bed/" + s + ".tss.bed"
            for s in sampletab["id"][sampletab["sample_type"] == "csrna"]
        ),
        in_in=" ".join(
            OUTPUT_DIR + "/bed/" + s + ".tss.bed"
            for s in sampletab["id"][sampletab["sample_type"] == "input"]
        ),
        valid_chroms=" ".join(VALID_CHROMS),
    shell:
        # The second sort is not redundant: "merge -s" emits merged records in the order it
        # meets them, interleaving strands, and the awk below names TSSs by NR. Re-sorting
        # first makes TSS_<n> follow coordinate order deterministically.
        """
            cat {params.in_cs} \
            | bedtools sort -i stdin \
            | bedtools merge -s -c 6 -o distinct -i stdin \
            | bedtools sort -i stdin \
            | awk -v vc="{params.valid_chroms}" \
                'BEGIN{{IFS="\t";OFS="\t";n=split(vc,a," ");for(i=1;i<=n;i++) ok[a[i]]=1}} \
                (ok[$1]){{print $1,$2,$3,"TSS_" NR,"0",$4}}' \
                > {output.cs}
            cat {params.in_in} \
            | bedtools sort -i stdin \
            | bedtools merge -s -c 6 -o distinct -i stdin \
            | bedtools sort -i stdin \
            | awk -v vc="{params.valid_chroms}" \
                'BEGIN{{IFS="\t";OFS="\t";n=split(vc,a," ");for(i=1;i<=n;i++) ok[a[i]]=1}} \
                (ok[$1]){{print $1,$2,$3,"TSS_" NR,"0",$4}}' \
                > {output.inp}
        """


